# RustDesk rendezvous server
HBBS_HOST=your-rustdesk-server.com
HBBS_WS_PORT=21118

# RustDesk relay server (usually same host)
HBBR_HOST=your-rustdesk-server.com
HBBR_WS_PORT=21119

# Server public key (from hbbs logs on first run)
SERVER_KEY=your-server-public-key-base64

# Port to expose the web UI on (default: 80)
WEB_PORT=80

# Docker Hub username (used by docker-compose.prod.yml and CI/CD)
DOCKER_USERNAME=yourdockerhubusername
