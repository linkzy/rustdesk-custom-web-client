{
  "name": "rclient-gateway",
  "version": "0.2.0",
  "description": "RustDesk web gateway service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "fake-host": "ts-node --transpile-only test/fake-host/cli.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "protobufjs": "^8.8.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^14.0.3",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
