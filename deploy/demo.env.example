# rclient demo instance — template for /home/demo/.env on the demo VPS.
#
# This file holds PLACEHOLDERS only and is safe to commit.
# The real .env lives on the VPS at /home/demo/.env (mode 600).
# NEVER copy the owner's production relay key here, and never commit a real key.

# --- Relay servers -----------------------------------------------------------
# Demo default: RustDesk's PUBLIC servers (R-14b), so a visitor can try the demo
# with just their own machine ID + password and no relay of their own.
# Visitors can still point at their own relay under "Advanced options".
HBBS_HOST=rs-ny.rustdesk.com
HBBS_WS_PORT=21118
HBBR_HOST=rs-ny.rustdesk.com
HBBR_WS_PORT=21119

# RustDesk's published public-server key (public information, NOT a secret and
# NOT the owner's key). It is deliberately not committed here: take the current
# value from RustDesk's official web client (https://rustdesk.com/web/), or from
# your own hbbs (`docker logs <hbbs> 2>&1 | grep "Key:"`). The deployed demo's
# /home/demo/.env holds the value; it is not in the repository.
SERVER_KEY=

# Own relay instead of the public one? Generate a FRESH key pair for the demo —
# never reuse the owner's. `hbbs` prints its public key on first run:
#   docker logs <hbbs-container> 2>&1 | grep "Key:"
# and put it here, with HBBS_HOST/HBBR_HOST pointing at your demo relay.

# --- Captcha -----------------------------------------------------------------
# The demo is frictionless: no captcha. Flip to true and set the two keys below
# if the public demo ever gets abused.
CAPTCHA_ENABLED=false
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=

# --- Web ---------------------------------------------------------------------
# Bound to 127.0.0.1 by docker-compose.demo.yml; cloudflared is the only public
# entry point. Change only if 8090 is taken on the host.
WEB_PORT=8090
