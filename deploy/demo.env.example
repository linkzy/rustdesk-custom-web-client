# Environment for a demo instance — TEMPLATE.
#
# This file holds placeholders only and is safe to commit. Copy it to `.env`
# beside the compose file on the demo host and fill in your own values; the real
# file is not committed (see .gitignore).

# --- Relay servers -----------------------------------------------------------
# The demo runs its OWN relay pair (hbbs + hbbr in docker-compose.demo.yml), so
# these point at that relay's DNS-only hostname. Do NOT point them at RustDesk's
# public servers: their relay ports may be unreachable from your host, and a demo
# you cannot verify is worse than none.
HBBS_HOST=relay-demo.example.com
HBBS_WS_PORT=21118
HBBR_HOST=relay-demo.example.com
HBBR_WS_PORT=21119

# The relay's PUBLIC key. This is public information — visitors paste it into
# their RustDesk — but it must be the key generated for THIS relay, never a key
# from another deployment. Generate it by starting hbbs with an empty data dir:
#   docker logs <hbbs-container> 2>&1 | grep "Key:"
# The private half stays on the host and is never committed.
SERVER_KEY=

# --- Captcha -----------------------------------------------------------------
# Optional. Turn it on if the demo gets attention and you want to slow abuse down.
CAPTCHA_ENABLED=false
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=

# --- Web ---------------------------------------------------------------------
# Bound to 127.0.0.1 by docker-compose.demo.yml; your proxy or tunnel is the only
# public entry point.
WEB_PORT=8090
