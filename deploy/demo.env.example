# rclient demo instance — template for /home/demo/.env on the demo VPS.
#
# This file holds PLACEHOLDERS only and is safe to commit.
# The real .env lives on the VPS at /home/demo/.env (mode 600).
# NEVER copy the owner's production relay key here, and never commit a real key.

# --- Relay servers -----------------------------------------------------------
# The demo runs its OWN relay pair (hbbs + hbbr in docker-compose.demo.yml), so
# these point at the DNS-only name for this host. Do NOT point them back at
# RustDesk's public servers: their relay ports are refused (see DEMO.md), which
# is why the demo has its own.
HBBS_HOST=relay-demo.linkzy.dev
HBBS_WS_PORT=21118
HBBR_HOST=relay-demo.linkzy.dev
HBBR_WS_PORT=21119

# The demo relay's public key. This is public information — visitors paste it
# into their RustDesk — but it must be the key generated FOR THIS DEMO, never
# the owner's production key. Generate it by starting hbbs with an empty
# relay-data dir:
#   docker compose up -d hbbs && docker logs rclient-demo-hbbs 2>&1 | grep "Key:"
# It is deliberately blank here: the real value lives only in /home/demo/.env
# (mode 600) on the VPS, so no key is ever committed to the repository.
SERVER_KEY=

# The live demo's key is also shown on the demo page and in DEMO.md, because
# visitors need it; the matching private key stays on the VPS in relay-data/,
# which is never committed.

# --- Captcha -----------------------------------------------------------------
# The demo is frictionless: no captcha. Flip to true and set the two keys below
# if the public demo ever gets abused.
CAPTCHA_ENABLED=false
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=

# --- Web ---------------------------------------------------------------------
# Bound to 127.0.0.1 by docker-compose.demo.yml; cloudflared is the only public
# entry point. Change only if 8090 is taken on the host.
WEB_PORT=8090
